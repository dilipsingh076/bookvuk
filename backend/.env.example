# Copy to .env and fill in. .env is gitignored; never commit real credentials.
#
# Configure the database EITHER with DATABASE_URL (one line, easiest for a
# managed provider) OR with the five discrete DATABASE_* fields. If both are
# present, DATABASE_URL wins.

# ---------------------------------------------------------------------------
# Option 1: Supabase (or any managed Postgres)
# ---------------------------------------------------------------------------
# Supabase dashboard -> Connect -> choose a connection string.
#
#   Session pooler  (port 5432, IPv4 + IPv6)  <- use this one for a normal server
#   Transaction pooler (port 6543)            <- for serverless/lambda
#   Direct connection (db.<ref>.supabase.co)  <- IPv6 only unless you buy the IPv4 add-on
#
# Replace [YOUR-PASSWORD] with the real password or the app refuses to start.
# The password is percent-encoded automatically, so special characters are fine.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SSLMODE=require
#
# To also verify the server certificate, download Supabase's CA cert and use:
# DATABASE_SSLMODE=verify-full
# DATABASE_SSLROOTCERT=/absolute/path/to/prod-ca-2021.crt

# ---------------------------------------------------------------------------
# Option 2: local Postgres
# ---------------------------------------------------------------------------
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=BookVuk
# Local servers usually have no TLS; leave DATABASE_SSLMODE unset.

# ---------------------------------------------------------------------------
# Connection pool (defaults are fine; tune for a remote database)
# ---------------------------------------------------------------------------
# Test a pooled connection before using it. Costs one round trip per request —
# measured at 243ms against a database in another region, ~2ms beside one. Set
# it to false when the database is far away, and lower the recycle below your
# provider's idle timeout (Supabase's pooler drops idle connections), so a
# connection is retired before it can go stale rather than checked every time.
# DATABASE_POOL_PRE_PING=true
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# DATABASE_POOL_RECYCLE_SECONDS=1800
# DATABASE_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# REQUIRED: generate your own with `openssl rand -hex 32`.
# Must be at least 32 characters. The app refuses to start with a known example
# key (such as the one in FastAPI's tutorial), because anyone recognising it
# could forge an admin token.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh tokens let the frontend renew an access token without a re-login.
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# CORS: comma-separated browser origins allowed to call the API
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Auth rate limits (per client IP, per process)
# ---------------------------------------------------------------------------
# LOGIN_RATE_LIMIT_ATTEMPTS=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# REGISTER_RATE_LIMIT_ATTEMPTS=5
# REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# ---------------------------------------------------------------------------
# Storefront identity (used in e-mail links and the sitemap)
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:5173
SITE_NAME=BookVuk

# ---------------------------------------------------------------------------
# E-mail. Without SMTP_HOST, messages are written to the log instead of sent,
# so password reset and order confirmation work locally without credentials.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# EMAIL_FROM=no-reply@bookvuk.com
# EMAIL_FROM_NAME=BookVuk
# PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Payments (Razorpay). Unset means checkout still records orders but marks them
# unpaid, rather than pretending money was collected.
# Dashboard -> Settings -> API Keys.
#
# Test and live keys are held side by side and RAZORPAY_MODE picks which pair is
# used, so switching to real money is one word and needs no key shuffling. One
# database serves both, which is why a test order is badged "test" in the admin:
# a rehearsal must be visibly a rehearsal or it lands in the revenue.
#
# These names were RAZORPAY_KEY_ID / _KEY_SECRET / _WEBHOOK_SECRET. If you set
# those, nothing reads them and every checkout silently records as unpaid.
# ---------------------------------------------------------------------------
# RAZORPAY_MODE=test            # test | live
# RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_TEST_KEY_SECRET=
# Webhook signing secret — a DIFFERENT value from the key secret, set under
# Settings -> Webhooks. Without it the webhook endpoint returns 503 and refuses
# everything, so an order paid in a closed tab is never marked paid.
# RAZORPAY_TEST_WEBHOOK_SECRET=
#
# The live trio. Needed before RAZORPAY_MODE=live is anything but an outage.
# RAZORPAY_LIVE_KEY_ID=
# RAZORPAY_LIVE_KEY_SECRET=
# RAZORPAY_LIVE_WEBHOOK_SECRET=
# CURRENCY=INR

# ---------------------------------------------------------------------------
# Order pricing
# ---------------------------------------------------------------------------
# What delivery costs the customer. A single book by courier is roughly 40-80
# rupees, so 49 is subsidised a little and the threshold is what pays for it.
# SHIPPING_FLAT_RATE=49.00
# FREE_SHIPPING_THRESHOLD=499    # 0 disables the threshold entirely
#
# Tax is 0 and should stay 0 while the shop sells printed books.
#
# `books.price` is the MRP from the cover, which is declared inclusive of all
# taxes under the Legal Metrology (Packaged Commodities) Rules, 2011 — adding to
# it sells above MRP. Printed books (HSN 4901) are also NIL-rated under GST.
#
# Set it only if you start selling something taxable, and see the note in
# config.py: at that point the rate belongs on the product, not the store.
# TAX_RATE=0

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_JSON=true

# ---------------------------------------------------------------------------
# Rate limiting: "memory" (per worker) or "database" (shared, no Redis needed)
# ---------------------------------------------------------------------------
# RATE_LIMIT_BACKEND=memory

# ---------------------------------------------------------------------------
# Object storage for uploaded book covers
# ---------------------------------------------------------------------------
# Leave unset locally: covers are written to `static/books/` and served by the
# /static mount, which is what a local run wants.
#
# SET THESE ON ANY HOSTED DEPLOYMENT. A container filesystem is ephemeral, so an
# uploaded cover written to disk is gone on the next deploy or restart — the
# upload returns 200 and the book quietly falls back to the placeholder days
# later. The seeded covers are unaffected; they are baked into the image.
#
# Create a **public** bucket in the Supabase dashboard (Storage -> New bucket),
# then set the three below. SUPABASE_SERVICE_KEY must be the *service role* key,
# not the anon key — the anon key cannot write under the default policies. It is
# a server-side secret and must never reach the frontend.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_STORAGE_BUCKET=book-covers

# Largest cover accepted. The body is read into memory, so this is what stops one
# request exhausting a small instance. Covers are ~60KB.
# MAX_COVER_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# Normally the worker is its own container (see docker-compose.yml) and this
# stays false. Set it true when the host has nowhere to run a second process —
# Render's free tier, for instance, offers only web services. Without a worker
# somewhere, order confirmations, refunds and abandoned-cart sweeps queue up and
# are never processed.
#
# Safe with several uvicorn workers: claiming is FOR UPDATE SKIP LOCKED, so two
# loops never take the same job.
# RUN_WORKER_IN_PROCESS=false
# WORKER_BATCH_SIZE=10
# WORKER_IDLE_SLEEP_SECONDS=2.0
# WORKER_SWEEP_INTERVAL_SECONDS=900

# ---------------------------------------------------------------------------
# JWT scoping (optional)
# ---------------------------------------------------------------------------
# Stamp and verify `iss` / `aud` on every token. Both off unless set.
#
# Turning either on invalidates tokens already issued — they carry no iss/aud —
# so everyone signs in once more. Worth knowing before flipping it in production.
# JWT_ISSUER=bookvuk
# JWT_AUDIENCE=bookvuk-web

# ---------------------------------------------------------------------------
# Store credit (buyback wallet)
# ---------------------------------------------------------------------------
# The most of one order that store credit may cover. Without a cap, a seller
# with a large balance checks out for nothing and the shop ships stock with no
# money arriving — buyback becomes a way to drain inventory.
# WALLET_MAX_REDEMPTION_PERCENT=50

# ---------------------------------------------------------------------------
# Buyback
# ---------------------------------------------------------------------------
# Where sellers post their books. Shown on the buyback instructions; the panel is
# omitted entirely while this is blank, rather than printing an empty address.
# Multi-line — keep it quoted.
# BUYBACK_SHIP_TO_ADDRESS="BookVuk Buyback\n12 Example Road\nPune 411001"
# How long a quote holds. The amount is fixed when it is given, so a seller
# posting a book weeks later is still paid what they were promised — which only
# works if the offer also ends.
# BUYBACK_QUOTE_VALID_DAYS=14
# How many photographs a seller may attach to one request.
# MAX_BUYBACK_PHOTOS=4

# ---------------------------------------------------------------------------
# Cash on delivery
#
# Also changeable at /admin/settings without a deploy, which is what the store
# settings screen is for; these are the values used until somebody sets one.
# ---------------------------------------------------------------------------
# COD_ENABLED=true
# Above this order total, online payment only. An order refused at the door
# costs the courier fee both ways, so the ceiling is a real protection.
# COD_MAX_ORDER_TOTAL=3000

# ---------------------------------------------------------------------------
# Retention — how long rows nobody needs any more are kept, in days
# ---------------------------------------------------------------------------
# Swept by the worker (core/sweeps.py) on the same timer as abandoned carts.
# Nothing used to delete these and four tables grew without bound as a result:
# `refresh_tokens` reached more rows than `books` on a database with 20 users.
# Set any to 0 to keep that table forever.
#
# The sweep never removes a *failed* job (it keeps `last_error` for inspection)
# or an *unread* notification, however old either is.
# REFRESH_TOKEN_RETENTION_DAYS=7
# JOB_RETENTION_DAYS=30
# NOTIFICATION_RETENTION_DAYS=90
# RATE_LIMIT_RETENTION_DAYS=1
# RETENTION_SWEEP_BATCH=1000

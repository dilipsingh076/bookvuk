# Base URL of the BookVuk API as seen from the browser. Next rewrites /api and
# /auth to the service, so this is normally the site's own origin.
NEXT_PUBLIC_API_BASE_URL=

# The API as seen from the Next server (server components, generateMetadata,
# the sitemap). Inside Docker this is the service name, not localhost.
API_INTERNAL_URL=http://127.0.0.1:8000

# Public origin of the storefront. Used for canonical URLs, link previews and the
# sitemap, all of which need absolute URLs. Must match the deployed host.
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# Public support details shown on the Contact page. The email defaults to
# support@bookvuk.com; the phone card is hidden entirely unless one is set,
# because a wrong number costs more trust than no number.
NEXT_PUBLIC_SUPPORT_EMAIL=support@bookvuk.com
# NEXT_PUBLIC_SUPPORT_PHONE=

# Origin serving uploaded book covers, when the API stores them in object
# storage rather than on its own disk. Must match the backend's SUPABASE_URL.
#
# Both `images.remotePatterns` and the CSP's `img-src` are derived from this —
# without it Next refuses to optimise the image and the browser blocks it, with
# nothing in the network tab explaining why.
#
# Leave unset locally: covers come from the API's /static mount through the
# rewrites, which is same-origin.
# NEXT_PUBLIC_MEDIA_ORIGIN=https://<project-ref>.supabase.co
